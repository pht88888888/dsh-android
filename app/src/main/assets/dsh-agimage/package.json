{
  "name": "dsh-agimage",
  "version": "1.0.0",
  "description": "常驻版 Agnes AI 图片生成工具（原动态插件 img-2 / Image Generation Tool v13 固化交付）：注册 generate_image 模型工具，结果图在会话内以 240px 上限 + 宽高比适配显示。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.append.yml"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.append.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
